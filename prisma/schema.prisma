// Flowlo - MySQL schema for auth, projects, and tasks
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  projects     Project[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  progress    Int      @default(0)
  color       String   @default("from-gray-500 to-gray-600")
  tasks       Int      @default(0)
  members     Int      @default(0)
  lastUpdated String
  status      String   @default("active")
  deadline    String?
  tags        String?  // JSON array as string
  team        String?  // JSON array as string
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  taskList    Task[]
  branches    Branch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentBoardId  String?
  title          String
  description    String   @default("")
  department     String   @default("")
  color          String   @default("from-gray-500 to-gray-600")
  workflowType   String   @default("custom")
  team           String?  // JSON array of member IDs
  tags           String?  // JSON
  lastUpdated    String   @default("Just now")
  isFavorite     Boolean  @default(false)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName    String
  projectColor   String   @default("")
  name           String
  description    String   @default("")
  assignee       String
  assigneeAvatar String   @default("")
  status         String   // 'Not started' | 'In progress' | 'Done' | 'On hold' or todo/in-progress/done for project tasks
  priority       String   @default("Medium")
  startDate      String?
  endDate        String?
  dueDate        String
  estimatedHours Int      @default(0)
  actualHours    Int      @default(0)
  tags           String?  // JSON
  attachments    Int      @default(0)
  comments       Int      @default(0)
  subtasks       String?  // JSON
  completedAt    String?
  createdAt      String
  updatedAt      String
}

// Branch phases (workflow columns) – saved in DB
model BranchPhase {
  id          String   @id @default(cuid())
  branchId    String
  projectId   String   // for ownership check
  title       String
  description String?
  color       String   @default("blue")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cards       BranchCard[]
}

// Branch cards (tasks in a branch/board)
model BranchCard {
  id             String   @id @default(cuid())
  branchId       String
  phaseId        String
  projectId      String
  title          String
  description    String   @default("")
  status         String   @default("todo")
  priority       String   @default("medium")
  assignee       String   @default("")
  assigneeAvatar String   @default("")
  dueDate        String
  tags           String?  // JSON
  estimatedHours Int      @default(0)
  attachments    Int      @default(0)
  comments       Int      @default(0)
  createdAt      String
  updatedAt      String
  phase          BranchPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
}
